# Copy to .env to change the lab account passwords:
#
#   cp .env.example .env
#   ./lab rebuild
#
# .env is gitignored. These are throwaway credentials for a local container
# that publishes no ports, so they are not really secrets — the split exists so
# you can change them without editing the Dockerfile, and so the repo follows
# the habit you'd want on a real project.
#
# If you don't create a .env at all, compose falls back to these same values.

STUDENT_PASSWORD=lfca123
ROOT_PASSWORD=lfca123
