# Names and empty values only — never a real secret. See docs/12-deployment.md §2.

# Neon connection string. Locally this is the *dev* branch, and the *direct*
# (unpooled) host: Neon routes schema migrations to the direct connection
# because transaction pooling breaks tools that hold a transaction open across
# statements. sslmode=verify-full is part of the string Neon gives you.
DATABASE_URL=

# Not used yet — sign-in is a later slice. Listed so the file stays the one
# place that says what the app will need.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
SENTRY_DSN=
