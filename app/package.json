{
  "name": "lfca-simulator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "auth:generate": "auth generate --config src/auth.ts --output src/db/schema/auth.ts --yes",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "next build && node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:denied": "ALLOWED_EMAILS=nobody@lfca.invalid next dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "^1.7.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.75.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
