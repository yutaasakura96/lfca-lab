{
  "name": "lfca-simulator",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "auth:generate": "auth generate --config src/auth.ts --output src/db/schema/auth.ts --yes",
    "seed": "node --env-file=.env.local scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  }
}
