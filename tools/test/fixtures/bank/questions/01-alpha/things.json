{
  "competency": "Alpha Domain :: Things",
  "items": [
    {
      "id": "q.alpha.things.widget.01",
      "concept_id": "alpha.things.widget",
      "pool": "exam",
      "type": "discrimination",
      "difficulty": 1,
      "stem": "Item 1 about the widget: which statement correctly identifies the widget?",
      "options": [
        {
          "ref": "o1",
          "text": "It is the widget.",
          "correct": true,
          "why": "That is the definition of the widget.",
          "provenance": {
            "kind": "key"
          }
        },
        {
          "ref": "o2",
          "text": "It is the gadget.",
          "correct": false,
          "why": "That describes the gadget, a different concept.",
          "provenance": {
            "kind": "confusable",
            "concept_id": "alpha.things.gadget"
          }
        },
        {
          "ref": "o3",
          "text": "It is the trinket.",
          "correct": false,
          "why": "That describes the trinket, a sibling concept.",
          "provenance": {
            "kind": "sibling",
            "concept_id": "alpha.things.trinket"
          }
        },
        {
          "ref": "o4",
          "text": "It is neither of these.",
          "correct": false,
          "why": "A common wrong belief about the widget.",
          "provenance": {
            "kind": "misconception",
            "documented_at": "data:notes:alpha.things.widget"
          }
        }
      ],
      "rationale": "The widget is identified by `widgetctl show`; `widgetctl list` enumerates all widgets for comparison.",
      "source_ids": [
        "fixture-spec"
      ],
      "guide_anchor": "01-alpha/things.md#c-alpha.things.widget",
      "comparison_block": "cmp-alpha.things.widget",
      "commands_covered": [
        "widgetctl show",
        "widgetctl list"
      ],
      "waived_source": false,
      "verification": null
    },
